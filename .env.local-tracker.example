# Конфигурация CLI OpenProject для проекта ivfx.
#
# Это НЕ пример, который копируют, а шаблон значений. Реальный файл
# `.env.local-tracker` содержит живой API-токен и в git не коммитится.
#
# Экземпляр OpenProject общий с проектом Karaoke:
#   https://github.com/svoemesto/Karaoke/blob/master/docs/tracker-setup.md
#
# Заполнить значения и скопировать в `.env.local-tracker`:
#   cp .env.local-tracker.example .env.local-tracker
#   chmod 600 .env.local-tracker
#
# Откуда взять токен: в OpenProject → My account → API tokens → создать
# для пользователя ai-agent. CLI ходит с Basic Auth, где имя пользователя
# всегда `apikey`, а пароль — значение TRACKER_API_TOKEN.

# Адрес OpenProject (без завершающего слэша)
TRACKER_URL=http://localhost:8080

# Имя API-токена для Basic Auth — всегда apikey, менять не нужно
TRACKER_USER=apikey

# Значение токена. Секрет.
TRACKER_API_TOKEN=

# Логин пользователя, от имени которого агент берёт задачи и оставляет комментарии
TRACKER_AGENT_USER=ai-agent

# Уровень логов CLI: ERROR, WARN, INFO, DEBUG
TRACKER_LOG_LEVEL=WARN

# Таймаут HTTP-запросов, секунд
TRACKER_HTTP_TIMEOUT=30